NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=

# Public base URL used in notification emails (for example https://nyayasetu.example)
APP_URL=

# Email via Resend. Blank = email notifications are recorded as skipped_no_provider.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Push is only offered in the UI when NEXT_PUBLIC_VAPID_PUBLIC_KEY is set.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Shared secret for the deadline cron: call /api/notifications/deadlines with header x-cron-secret
CRON_SECRET=
